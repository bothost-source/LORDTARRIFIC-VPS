# Database
DATABASE_URL=postgresql://vps_user:vps_pass@localhost:5432/vps_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-this-to-a-64-char-random-string-now-please-do-it
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Proxmox
PROXMOX_HOST=https://your-proxmox-node:8006
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=your-proxmox-password
PROXMOX_VERIFY_SSL=false

# DDoS Shield
DDOS_PPS_THRESHOLD=100000
DDOS_MBPS_THRESHOLD=500
DDOS_NULLROUTE_MINUTES=30

# App
APP_NAME=VPS Platform
DEBUG=false
